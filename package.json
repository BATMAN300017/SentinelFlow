{
  "name": "sentinelflow-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SentinelFlow AI — The Self-Directed Fraud Investigation Platform",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "deploy": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy frontend/out --project-name=sentinelflow",
    "preview": "wrangler deploy",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm --filter frontend test"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "prettier": "^3.2.5",
    "wrangler": "4.156.0"
  }
}
